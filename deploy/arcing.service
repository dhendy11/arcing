[Unit]
Description=arcing (Next.js)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/deploy/arcing/current
EnvironmentFile=/srv/deploy/arcing/.env
Environment=NODE_ENV=production PORT=3006 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/srv/deploy/arcing/data

[Install]
WantedBy=multi-user.target
